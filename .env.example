# 이 파일을 .env 로 복사한 뒤 값을 채워 주세요. (.env 는 git에 올라가지 않습니다)

# Neon 대시보드 > Connection string (pooled 연결 권장)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# 가계부 로그인 비밀번호
APP_PASSWORD=change-me

# (선택) 세션 서명용 비밀키. 비워두면 APP_PASSWORD에서 파생됩니다.
SESSION_SECRET=

# (선택) 로컬 서버 포트
PORT=3000
